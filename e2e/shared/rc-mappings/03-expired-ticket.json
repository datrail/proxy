{
  "priority": 1,
  "request": {
    "method": "GET", "urlPath": "/v1/tickets",
    "queryParameters": {"sandbox_name": {"equalTo": "e2e-expired"}}
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "body": "{\"host_id\":\"{{request.query.host_id}}\",\"tickets\":[{\"agent_id\":\"agent-e2e-expired\",\"sandbox_name\":\"e2e-expired\",\"token\":\"e2e-expired-token\",\"expires_at\":\"{{now offset='-1 hours' timezone='UTC' format=\"yyyy-MM-dd'T'HH:mm:ss'Z'\"}}\",\"posture_score\":90,\"tier\":\"green\"}]}"
  }
}
