{
  "priority": 1,
  "request": {
    "method": "POST", "urlPath": "/mcp",
    "bodyPatterns": [{"matchesJsonPath": "$[?(@.method == 'tools/list')]"}]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json", "Mcp-Session-Id": "e2e-upstream-session"},
    "body": "{\"jsonrpc\":\"2.0\",\"id\":{{jsonPath request.body '$.id'}},\"result\":{\"tools\":[{\"name\":\"track_package\",\"description\":\"Track a package by its id.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}}]}}"
  }
}
