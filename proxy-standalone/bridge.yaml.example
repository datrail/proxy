# Copy to bridge.yaml and list your upstream MCP servers. Every other setting
# is an environment variable: see proxy-standalone/README.md.

# This file's format version (not the policy bundle's). A proxy reads any 1.x
# and refuses 2.x; if omitted, 1.0 is assumed, with a warning.
schema_version: "1.0"

mcp:
  servers:
    # The agent sees this upstream's tools as `<name>_<tool>`, so renaming it
    # renames every tool. Always applied, even with a single upstream.
    - name: delivery
      url: http://gateway:8080/mcp
